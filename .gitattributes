# Release artifacts must retain their exact build bytes on every platform.
# In particular, bundle.js and its .bin must decode to identical contents.
dist/** -text whitespace=cr-at-eol

# Preserve gameplay data bytes across checkouts for the handshake hash.
data/*.json -text whitespace=cr-at-eol
maps/maps.json -text whitespace=cr-at-eol
maps/*.tmj -text whitespace=cr-at-eol
maps/*.tsj -text whitespace=cr-at-eol
